# Ключи «Героёнка». На проде это секреты Cloudflare Worker'а: npx wrangler secret put ИМЯ.
# Локально для npx wrangler dev — файл .dev.vars в корне (формат тот же, в git не попадает).
# Этот файл — только список: реальные ключи сюда не вписывать.

# --- ИИ-провайдеры (все с бесплатным тарифом, заполните сколько есть) ---
# Порядок опроса; ненастроенные (без ключа) пропускаются.
PROVIDER_ORDER=gemini,groq,openrouter,cerebras

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Запасной сервис для иллюстраций (на текущем ключе квота на картинки нулевая)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Groq — https://console.groq.com/keys (без карты)
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys (модели с суффиксом :free)
OPENROUTER_API_KEY=

# Cerebras — https://cloud.cerebras.ai (без карты)
CEREBRAS_API_KEY=

# Платный OpenAI: иллюстрации с ребёнком (gpt-image-1.5) и последний запасной вариант для текста
OPENAI_API_KEY=

# Ручная разблокировка книги (заголовок x-admin-key), пока нет оплаты: длинная случайная строка
ADMIN_KEY=

# --- Тонкая настройка (необязательно) ---
# Список моделей у провайдера через запятую, приоритет слева направо:
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# Сколько секунд максимум ждём ИИ, после этого отдаём локальную книгу
# AI_DEADLINE_MS=40000
