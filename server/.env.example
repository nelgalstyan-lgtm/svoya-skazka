PORT=3000

# --- ИИ-провайдеры (все с бесплатным тарифом, заполните сколько есть) ---
# Порядок опроса; ненастроенные (без ключа) пропускаются.
PROVIDER_ORDER=gemini,groq,openrouter,cerebras

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Тот же ключ используется и для геройских иллюстраций (лицо ребёнка) — отдельный ключ не нужен
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Groq — https://console.groq.com/keys (без карты)
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys (модели с суффиксом :free)
OPENROUTER_API_KEY=

# Cerebras — https://cloud.cerebras.ai (без карты)
CEREBRAS_API_KEY=

# Платный OpenAI. Пока не нужен: не задавайте ключ — тогда он не используется.
# OPENAI_API_KEY=

# --- Тонкая настройка (необязательно) ---
# Список моделей у провайдера через запятую, приоритет слева направо:
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# Сколько секунд максимум ждём ИИ, после этого отдаём локальную книгу
# AI_DEADLINE_MS=40000
# Сколько заказов генерируем одновременно
# QUEUE_CONCURRENCY=3
# Лимит заказов с одного IP за 10 минут
# RATE_LIMIT_MAX=10
# Таймаут «Сказки», если приложены фото (текст + лист персонажа, обложка и 8 иллюстраций), мс
# PHOTO_BOOK_TIMEOUT_MS=360000
# Таймаут «Большой истории» (план + 6 глав + лист персонажа, обложка и 8–10 иллюстраций), мс
# BIG_BOOK_TIMEOUT_MS=720000
# Сколько времени из этого отводится на иллюстрации (не успели — страница остаётся с фоновой сценой), мс
# SHORT_IMAGE_BUDGET_MS=240000
# BIG_IMAGE_BUDGET_MS=300000
# Сколько иллюстраций рисуется одновременно
# IMAGE_CONCURRENCY=3
# Бесплатных перерисовок иллюстраций на одну книгу
# REDRAW_LIMIT=3
# Сколько дней хранится готовая книга (без фото — фото не хранятся вовсе); нужна для ссылки и QR-кода
# BOOK_TTL_DAYS=365

# Иллюстрации через OpenAI (основной сервис картинок, если задан ключ; Gemini — запасной).
# Баланс OpenAI пополняется заранее: platform.openai.com → Settings → Billing
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# Точность лица: high | low (low — если фото клиентов часто маленькие)
# OPENAI_INPUT_FIDELITY=high
# Лимит на одну картинку, мс
# IMAGE_TIMEOUT_MS=180000
# Качество: low | medium | high — влияет на цену каждой картинки
# OPENAI_IMAGE_QUALITY=medium
# Какой сервис картинок пробовать первым: openai | gemini
# IMAGE_PROVIDER=openai
