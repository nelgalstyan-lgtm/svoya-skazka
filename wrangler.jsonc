// Cloudflare Worker «Героёнок»: сайт (статика из dist/) и API на /api/* (worker/), книги рисует Workflow.
// Workers Builds запускает `npx wrangler deploy` при каждом пуше в main, сборка сайта — через build.command.
// Секреты (не в git): OPENAI_API_KEY, GEMINI_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY, ADMIN_KEY —
// `npx wrangler secret put ИМЯ`; локально для `npx wrangler dev` — файл .dev.vars.
{
  "name": "svoya-skazka",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "bash scripts/build-pages.sh" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "geroenok" }],
  "workflows": [{ "name": "geroenok-book", "binding": "BOOK_WORKFLOW", "class_name": "BookWorkflow" }],
  // лимиты с одного адреса в минуту: бесплатное превью стоит ≈15 ₽ картинок
  "ratelimits": [
    { "name": "GEN_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "BIG_LIMITER", "namespace_id": "1002", "simple": { "limit": 1, "period": 60 } },
    { "name": "EDIT_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
